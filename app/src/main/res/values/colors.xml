<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   colors.xml — the app's palette. ONE source of truth for every colour.
  ============================================================================

  ONBOARDING NOTE
  ===============
  RULES
  1. Never type a hex colour in a layout. Reference a name from here. When the
     design changes, you change one line instead of grepping 40 XML files.
  2. Name by ROLE, not by appearance: `colorError`, not `red`.
  3. Give every name in `values/` a counterpart in `values-night/` (see
     themes.xml) if it changes with the system theme.

  The previous version of this file carried the full Material colour palette
  (red_50 ... grey_900, ~300 entries). It has been trimmed to what this app
  actually uses, because 300 unused names is how you learn to ignore the file.
  RockyGo's colors.xml keeps the full palette plus its brand colours.
-->
<resources>

    <!-- ===== Brand ===== -->
    <color name="colorPrimary">#1F6FEB</color>
    <color name="colorPrimaryDark">#12376F</color>
    <color name="colorAccent">#00BFA5</color>

    <!-- ===== Surfaces ===== -->
    <color name="windowBackground">#F5F6F8</color>
    <color name="surface">#FFFFFF</color>

    <!-- ===== Text ===== -->
    <color name="textPrimary">#1A1C1E</color>
    <color name="textSecondary">#5B6169</color>

    <!-- ===== State ===== -->
    <color name="colorError">#D32F2F</color>

    <!-- ===== Base ===== -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>

</resources>
