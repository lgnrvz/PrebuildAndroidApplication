<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   menu_main.xml — the toolbar's overflow menu.
  ============================================================================

  ONBOARDING NOTE
  ===============
  app:showAsAction options:
    always  -> icon sits in the toolbar (no text unless withText)
    ifRoom  -> in the toolbar if there is space, overflow otherwise
    never   -> always in the three-dot overflow

  `never` here is deliberate: it needs no icon asset, so this file has zero
  drawable dependencies and cannot break the build on a missing vector. Use
  ifRoom + an icon for actions users hit often.

  The ids (action_sync) are what MainActivity's setOnMenuItemClickListener
  switches on. When a menu item "does nothing", it is almost always:
    1. the id in XML does not match the R.id constant in `when`, or
    2. the listener was set on the Toolbar while the screen also overrides
       onOptionsItemSelected - two listeners, one of them silently wins.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_sync"
        android:title="@string/action_sync"
        app:showAsAction="never" />
</menu>
