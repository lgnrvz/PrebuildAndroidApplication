<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   themes.xml (light) — the app's visual identity.
  ============================================================================

  ONBOARDING NOTE
  ===============
  THEME vs STYLE: a theme is a style applied to a whole Activity (or the app);
  a style is applied to one view. Same syntax, different scope.

  `parent="...NoActionBar"` is deliberate: our layouts put a MaterialToolbar
  inside the layout, so the system must NOT add a second one. That is also why
  each Activity calls setSupportActionBar(mBinding.toolbar) - the toolbar in the
  layout becomes the action bar.

  `colorPrimary` / `colorPrimaryVariant` / `colorOnPrimary` are the Material
  attributes that drive every widget's default colour. Override them HERE, and
  every button, FAB, cursor and floating label follows. That is why there is not
  a single hardcoded colour in any layout file.

  Every style name in values/ MUST also exist in values-night/ (see that file),
  otherwise a dark-mode device falls back to these light colours and the app
  looks broken in exactly one configuration - which is the one nobody tests.
-->
<resources>

    <style name="Theme.PrebuildApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surfaces -->
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>

        <!-- Errors -->
        <item name="colorError">@color/colorError</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/windowBackground</item>
    </style>

</resources>
